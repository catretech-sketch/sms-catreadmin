# API base URL (must include /v1). Pick the one matching how you run sms-backend:
#   local `dotnet run --project src/Sms.Api`  ->  http://localhost:5162/v1   (default below)
#   docker `docker compose up` (host port map 5080:8080)  ->  http://localhost:5080/v1
VITE_API_BASE_URL=http://localhost:5162/v1
